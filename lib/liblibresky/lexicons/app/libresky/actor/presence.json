{
  "lexicon": 1,
  "id": "app.libresky.actor.presence",
  "description": "Internal last seen LibreSky writes while the app is open. Another LibreSky window reads it to tell a LibreSky account from any other, and to show online and available. The time is not shown.",
  "defs": {
    "main": {
      "type": "record",
      "description": "The account's last seen.",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": ["seenAt"],
        "properties": {
          "seenAt": { "type": "string", "format": "datetime" },
          "status": {
            "type": "string",
            "knownValues": ["available", "away"],
            "maxLength": 16
          }
        }
      }
    }
  }
}
