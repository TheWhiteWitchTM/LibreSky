{
  "lexicon": 1,
  "id": "app.libresky.actor.links",
  "description": "Public social links LibreSky shows under a profile. Stored in the account repo, so another LibreSky window can read them.",
  "defs": {
    "main": {
      "type": "record",
      "description": "The account's social link row.",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": ["links"],
        "properties": {
          "links": {
            "type": "array",
            "maxLength": 8,
            "items": { "type": "ref", "ref": "#link" }
          }
        }
      }
    },
    "link": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri", "maxLength": 2000 },
        "label": { "type": "string", "maxLength": 80, "maxGraphemes": 40 },
        "kind": {
          "type": "string",
          "knownValues": ["website", "x", "instagram", "youtube", "github", "mastodon", "tiktok", "facebook", "linkedin", "threads", "bluesky", "discord", "twitch", "reddit", "spotify", "telegram", "patreon", "paypal", "other"],
          "maxLength": 32
        }
      }
    }
  }
}
