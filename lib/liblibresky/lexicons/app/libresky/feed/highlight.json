{
  "lexicon": 1,
  "id": "app.libresky.feed.highlight",
  "description": "A post the account shows on its Highlights tab. The record is public in the account repo.",
  "defs": {
    "main": {
      "type": "record",
      "description": "A highlighted post.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["subject", "createdAt"],
        "properties": {
          "subject": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
