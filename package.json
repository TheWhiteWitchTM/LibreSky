{
  "name": "libresky",
  "version": "1.0.0",
  "description": "High-performance, sleek Bluesky client with real-time @/# prediction, local AI integration, and OLED true-black aesthetic.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:web": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"cross-env NODE_ENV=development electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:build:linux": "vite build && electron-builder --linux AppImage deb",
    "electron:build:win": "vite build && electron-builder --win nsis"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheWhiteWitchTM/LibreSky.git"
  },
  "keywords": [
    "bluesky",
    "atproto",
    "electron",
    "ollama",
    "local-ai",
    "dark-theme",
    "pwa"
  ],
  "author": "TheWhiteWitchTM",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/TheWhiteWitchTM/LibreSky/issues"
  },
  "homepage": "https://TheWhiteWitchTM.github.io/LibreSky",
  "build": {
    "appId": "com.libresky.app",
    "productName": "LibreSky",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "@atproto/api": "^0.28.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
